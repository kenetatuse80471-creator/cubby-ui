{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "tokens:build": {
      "inputs": [
        "src/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "tokens:check": {
      "dependsOn": [
        "tokens:build"
      ],
      "cache": false
    },
    "lint:tokens": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  }
}
