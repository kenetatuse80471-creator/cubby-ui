{
  "name": "www",
  "version": "0.0.0",
  "private": true,
  "description": "Cubby UI showcase site: the catalogue, the component pages and the registry endpoints.",
  "type": "module",
  "scripts": {
    "registry:build": "pnpm -w exec shadcn build registry.json --output apps/www/public/r",
    "prebuild": "pnpm run registry:build",
    "predev": "pnpm run registry:build",
    "dev": "next dev --port 4320",
    "build": "next build",
    "start": "next start --port 4320",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@cubby-ui/registry": "workspace:*",
    "@cubby-ui/tokens": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@hugeicons/core-free-icons": "4.3.2",
    "@hugeicons/react": "1.1.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "motion": "13.2.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.4.3",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react-docgen-typescript": "2.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
